# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.url text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.war binary
*.jar binary
